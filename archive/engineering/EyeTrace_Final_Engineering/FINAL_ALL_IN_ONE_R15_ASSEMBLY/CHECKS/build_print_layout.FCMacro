import FreeCAD as A, Mesh, json, os
from FreeCAD import Vector as V
root=r'EyeTrace_Final_Engineering'; out=root+r'\FINAL_ALL_IN_ONE_R15_ASSEMBLY'; srcdir=root+r'\FINAL_ALL_IN_ONE_R15_LAYOUT_FIXED\STL'; val=json.load(open(root+r'\FINAL_ALL_IN_ONE_R15_LAYOUT_FIXED\CHECKS\layout_validation.json',encoding='utf-8-sig'))
tr={x['name']:x['translation_mm'] for x in val['geometry_comparison']}
# mesh copy from source STL, then placement exactly equal to transform independently matched to the fixed 3MF facets.
d=A.newDocument('EyeTrace_R15_Print_Layout'); grp=d.addObject('App::DocumentObjectGroup','Fixed3MFLayout');grp.Label='13 parts ? exact fixed 3MF plate arrangement'
rows=[]
for c in val['components']:
 name=c['name']; fn=os.path.join(srcdir,name+'.stl'); mesh=Mesh.Mesh(fn)
 obj=d.addObject('Mesh::Feature','Part_'+str(len(rows)+1).zfill(2));obj.Label=name;obj.Mesh=mesh
 t=tr[name];obj.Placement.Base=V(t[0],t[1],t[2]);grp.addObject(obj)
 b=obj.Mesh.BoundBox;rows.append({'name':name,'facets':obj.Mesh.CountFacets,'translation_mm':t,'bounds':[b.XMin,b.YMin,b.ZMin,b.XMax,b.YMax,b.ZMax],'solid':obj.Mesh.isSolid()})
d.recompute();d.saveAs(out+r'\CAD\EyeTrace_R15_Print_Layout.FCStd')
bounds=[min(x['bounds'][i] for x in rows) for i in range(3)]+[max(x['bounds'][i+3] for x in rows) for i in range(3)]
report={'source_3mf':root+r'\FINAL_ALL_IN_ONE_R15_LAYOUT_FIXED\EyeTrace_K2_ABS_All_In_One_R15_Fixed.3mf','source_meshes':srcdir,'placements_crosschecked_to_exact_3mf':True,'part_count':len(rows),'parts':rows,'overall_bounds_mm':bounds,'within_260x260_bed':bounds[0]>=0 and bounds[1]>=0 and bounds[3]<=260 and bounds[4]<=260,'all_z0':all(abs(r['bounds'][2])<1e-6 for r in rows)}
open(out+r'\CHECKS\print_layout_geometry_audit.json','w').write(json.dumps(report,indent=2))


