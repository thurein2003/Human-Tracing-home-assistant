import FreeCAD as A,json
out=r'EyeTrace_Final_Engineering\FINAL_ALL_IN_ONE_R15_ASSEMBLY';d=A.openDocument(out+r'\CAD\EyeTrace_R15_Full_Assembly.FCStd');exec(open(out+r'\CAD\Set_Pan_Tilt_Angles.py').read());before=d.getObject('Tilt_OriginalStar_PROVISIONAL').Placement;set_pan_tilt_angles(30,15,d);after=d.getObject('Tilt_OriginalStar_PROVISIONAL').Placement;pivot=A.Vector(-41,0,78);moved=after.multVec(pivot);expected=A.Rotation(A.Vector(0,0,1),30).multVec(pivot);set_pan_tilt_angles(0,0,d);reset=d.getObject('Tilt_OriginalStar_PROVISIONAL').Placement;r={'before':[before.Base.x,before.Base.y,before.Base.z],'after_base':[after.Base.x,after.Base.y,after.Base.z],'pivot_after_combined':[moved.x,moved.y,moved.z],'expected_pan_rotated_pivot':[expected.x,expected.y,expected.z],'reset_base':[reset.Base.x,reset.Base.y,reset.Base.z],'pivot_error_mm':moved.distanceToPoint(expected),'script_pass':moved.distanceToPoint(expected)<1e-7 and reset.Base.distanceToPoint(before.Base)<1e-7};open(out+r'\CHECKS\motion_helper_smoke_test.json','w').write(json.dumps(r,indent=2));A.closeDocument(d.Name)
