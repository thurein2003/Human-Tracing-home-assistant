import FreeCAD as App,Part,json
from FreeCAD import Vector as V
src=r'EyeTrace_Final_Engineering\EyeTrace_R20_UltraLowProfile\CAD\EyeTrace_R20_UltraLowProfile.FCStd'
d=App.openDocument(src); cover=d.getObject('Pan_KeyedHorn_Cover'); orig=cover.Shape; bb=orig.BoundBox; z=bb.ZMin; h=bb.ZLength; horn=d.getObject('Pan_OriginalStar_PROVISIONAL')
base=orig.common(Part.makeBox(44,4.6,h+1,V(-22,-2.3,z-0.5)).fuse(Part.makeBox(4.6,44,h+1,V(-2.3,-22,z-0.5)))).removeSplitter()
# use retained screw pads plus cross arms; add a narrow annular bridge to connect the four arms, retaining an open center.
pads=[]
for x,y in [(18,0),(-18,0),(0,18),(0,-18)]:pads.append(Part.makeCylinder(5.8,h+1,V(x,y,z-0.5)))
sh=base
for p in pads:sh=sh.fuse(orig.common(p)).removeSplitter()
r=[]
for ri,ro in [(4.1,4.8),(4.1,5.2),(4.1,5.8),(4.3,5.8),(4.5,6.2)]:
 ring=Part.makeCylinder(ro,h,V(0,0,z)).cut(Part.makeCylinder(ri,h+2,V(0,0,z-1)))
 test=sh.fuse(ring).removeSplitter()
 inter=test.common(horn.Shape)
 r.append({'ri':ri,'ro':ro,'valid':test.isValid(),'solids':len(test.Solids),'volume':round(test.Volume,2),'added_ring_mm3':round(test.Volume-sh.Volume,2),'horn_intersection_mm3':round(inter.Volume,6),'bbox':[test.BoundBox.XMin,test.BoundBox.XMax,test.BoundBox.YMin,test.BoundBox.YMax]})
print(json.dumps({'base_solids':len(base.Solids),'base_vol':base.Volume,'pre_ring_solids':len(sh.Solids),'candidates':r},indent=2));App.closeDocument(d.Name)
