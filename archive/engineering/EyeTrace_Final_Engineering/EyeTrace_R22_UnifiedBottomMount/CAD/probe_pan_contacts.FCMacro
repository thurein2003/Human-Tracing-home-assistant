import FreeCAD as App,json
p=r'EyeTrace_Final_Engineering\EyeTrace_R22_UnifiedBottomMount\CAD\EyeTrace_R22_UnifiedBottomMount.FCStd';d=App.openDocument(p)
n=['Base_EarMount_ThrustSupport','Pan_Replaceable_ThrustRing','PanYoke_EarBracket_KeyedDrive']; out=[]
for i in range(3):
 a=d.getObject(n[i]).Shape
 for j in range(i+1,3):
  b=d.getObject(n[j]).Shape
  out.append({'pair':[n[i],n[j]],'common_volume':a.common(b).Volume,'distance':a.distToShape(b)[0],'common_faces':len(a.common(b).Faces),'common_edges':len(a.common(b).Edges)})
open(r'EyeTrace_Final_Engineering\EyeTrace_R22_UnifiedBottomMount\DOCUMENTATION\pan_contact_probe.json','w').write(json.dumps(out,indent=2))
