import FreeCAD as App, json
p=r'EyeTrace_Final_Engineering\EyeTrace_R22_UnifiedBottomMount\CAD\EyeTrace_R22_UnifiedBottomMount.FCStd'
d=App.openDocument(p)
out=[]
for name in ['PanYoke_EarBracket_KeyedDrive','Pan_Replaceable_ThrustRing','Pan_KeyedHorn_Cover']:
 o=d.getObject(name);s=o.Shape
 out.append({'name':name,'placement':str(o.Placement),'bbox':[s.BoundBox.XMin,s.BoundBox.XMax,s.BoundBox.YMin,s.BoundBox.YMax,s.BoundBox.ZMin,s.BoundBox.ZMax],'volume':s.Volume,'solids':len(s.Solids),'valid':s.isValid()})
y=d.getObject('PanYoke_EarBracket_KeyedDrive').Shape;r=d.getObject('Pan_Replaceable_ThrustRing').Shape
f=y.fuse(r).removeSplitter()
out.append({'union_valid':f.isValid(),'union_solids':len(f.Solids),'union_volume':f.Volume,'separate_sum':y.Volume+r.Volume,'intersection':y.common(r).Volume,'bbox':[f.BoundBox.XMin,f.BoundBox.XMax,f.BoundBox.YMin,f.BoundBox.YMax,f.BoundBox.ZMin,f.BoundBox.ZMax]})
open(r'EyeTrace_Final_Engineering\EyeTrace_R22_UnifiedBottomMount\DOCUMENTATION\ring_union_probe.json','w').write(json.dumps(out,indent=2))
