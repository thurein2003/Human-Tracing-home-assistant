import FreeCAD as App,json
p=r'EyeTrace_Final_Engineering\EyeTrace_R22_UnifiedBottomMount\CAD\EyeTrace_R22_UnifiedBottomMount.FCStd'
d=App.openDocument(p);s=d.getObject('PanYoke_EarBracket_KeyedDrive').Shape;arr=[]
for i,f in enumerate(s.Faces):
 su=f.Surface
 if 'Cylinder' in type(su).__name__:
  c=su.Center;a=su.Axis;b=f.BoundBox
  arr.append({'face':i+1,'r':su.Radius,'center':[round(c.x,3),round(c.y,3),round(c.z,3)],'axis':[round(a.x,3),round(a.y,3),round(a.z,3)],'area':round(f.Area,2),'bbox':[round(b.XMin,2),round(b.XMax,2),round(b.YMin,2),round(b.YMax,2),round(b.ZMin,2),round(b.ZMax,2)]})
print(json.dumps(arr,indent=2));App.closeDocument(d.Name)
