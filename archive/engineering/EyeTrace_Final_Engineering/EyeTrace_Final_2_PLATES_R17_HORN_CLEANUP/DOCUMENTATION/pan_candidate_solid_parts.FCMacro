import FreeCAD as A,Part,json,os
from FreeCAD import Vector as V
E=r'EyeTrace_Final_Engineering'; d=A.openDocument(os.path.join(E,'EyeTrace_Final_2_PLATES_R16_COMPACT_SERVO','CAD','EyeTrace_R16_CompactServo_Assembly_HOLD.FCStd'));m=A.openDocument(os.path.join(E,'CrossHorn_ABS_Revision_01','PROTOTYPE_04_REVISION_15','CrossHorn_UltraMinimal_FitTest_04R15.FCStd'))
base=m.getObject('BaseCoupon').Shape;final=m.getObject('FinalCoupon').Shape;exp=base.cut(final);disk=Part.makeCylinder(20.5,3.8,V(0,0,0),V(0,0,1));rot=A.Rotation(V(1,0,0),180);top=V(0,0,33)
def tr(sh):
 q=sh.copy();q.rotate(V(0,0,0),rot.Axis,rot.Angle*180/3.141592653589793);q.translate(top-rot.multVec(V(0,0,3.8)));return q
patch=tr(disk.cut(exp));expg=tr(exp);old=d.getObject('PanYoke_EarBracket_KeyedDrive').Shape; keep=[d.getObject('Pan_KeyedHorn_Cover').Shape.makeOffsetShape(.2,.05,True)]
for i in range(4):
 for so in d.getObject('PanDrive_M3x10_'+str(i)).Shape.Solids:keep.append(so.makeOffsetShape(.2,.05,True))
sh=old.fuse(patch)
for q in keep:sh=sh.cut(q)
sh=sh.cut(expg)
res=[]
for i,s in enumerate(sh.Solids):
 b=s.BoundBox;res.append({'i':i,'vol':float(s.Volume),'bbox':[b.XMin,b.YMin,b.ZMin,b.XMax,b.YMax,b.ZMax]})
with open(os.path.join(E,'EyeTrace_R17_PLATE_02_ASSEMBLY_REPAIR','REPORTS','PAN_CANDIDATE_SOLIDS.json'),'w') as f:json.dump(res,f,indent=2)
