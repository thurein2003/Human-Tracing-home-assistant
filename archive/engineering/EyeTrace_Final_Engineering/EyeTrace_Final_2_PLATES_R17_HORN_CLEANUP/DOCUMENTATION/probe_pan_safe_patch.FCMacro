import FreeCAD as A,Part,os,json
from FreeCAD import Vector as V
eng=r'EyeTrace_Final_Engineering'; out=os.path.join(eng,'EyeTrace_R17_PLATE_02_ASSEMBLY_REPAIR')
d=A.openDocument(os.path.join(eng,'EyeTrace_Final_2_PLATES_R16_COMPACT_SERVO','CAD','EyeTrace_R16_CompactServo_Assembly_HOLD.FCStd'))
m=A.openDocument(os.path.join(eng,'CrossHorn_ABS_Revision_01','PROTOTYPE_04_REVISION_15','CrossHorn_UltraMinimal_FitTest_04R15.FCStd'))
base=m.getObject('BaseCoupon').Shape;final=m.getObject('FinalCoupon').Shape;exp=base.cut(final);disk=Part.makeCylinder(20.5,3.8,V(0,0,0),V(0,0,1));rot=A.Rotation(V(1,0,0),180);top=V(0,0,33)
def tr(sh):
 q=sh.copy();q.rotate(V(0,0,0),rot.Axis,rot.Angle*180/3.141592653589793);q.translate(top-rot.multVec(V(0,0,3.8)));return q
env=tr(disk);expG=tr(exp);patch=tr(disk.cut(exp));old=d.getObject('PanYoke_EarBracket_KeyedDrive').Shape
cover=d.getObject('Pan_KeyedHorn_Cover').Shape
screws=[d.getObject('PanDrive_M3x10_'+str(i)).Shape for i in range(4)]
res={'exp_volume':float(exp.Volume),'exp_solids':len(exp.Solids),'exp_bbox':[exp.BoundBox.XMin,exp.BoundBox.YMin,exp.BoundBox.ZMin,exp.BoundBox.XMax,exp.BoundBox.YMax,exp.BoundBox.ZMax]}
for label,sh in [('cover',cover)]+[('screw'+str(i),q) for i,q in enumerate(screws)]:
 try:
  off=sh.makeOffsetShape(0.20,0.05,True);res[label+'_offset']={'ok':bool(off.isValid()),'solids':len(off.Solids),'vol':float(off.Volume),'bbox':[off.BoundBox.XMin,off.BoundBox.YMin,off.BoundBox.ZMin,off.BoundBox.XMax,off.BoundBox.YMax,off.BoundBox.ZMax]}
 except Exception as e:res[label+'_offset']={'ok':False,'err':str(e)}
 res[label+'_patch_intersection']=float(patch.common(sh).Volume);res[label+'_oldcarrier_intersection']=float(old.common(sh).Volume)
h=d.getObject('Pan_OriginalStar_PROVISIONAL').Shape
res['horn']={'bbox':[h.BoundBox.XMin,h.BoundBox.YMin,h.BoundBox.ZMin,h.BoundBox.XMax,h.BoundBox.YMax,h.BoundBox.ZMax],'volume':float(h.Volume),'horn_in_pocket_volume':float(h.common(expG).Volume),'added_patch_intersection':float(h.common(patch).Volume)}
with open(os.path.join(out,'REPORTS','PAN_SAFE_PATCH_PROBE.json'),'w') as f:json.dump(res,f,indent=2)
