import FreeCAD as A,FreeCADGui as G,Part,os,json,traceback
from FreeCAD import Vector as V
from PySide import QtCore,QtWidgets,QtGui
R=os.path.dirname(os.path.abspath(__file__))
def run():
 try:
  doc=A.openDocument(os.path.join(R,'CAD','Physical_Verification_Optimized.FCStd'));objects=[o for o in doc.Objects if hasattr(o,'SourceCoupon')];qa={};colors=[(.15,.5,.75),(.9,.55,.12),(.85,.4,.12),(.15,.6,.35),(.3,.6,.8),(.18,.4,.72),(.6,.3,.72)]
  def scene(name,items,view='iso'):
   d=A.newDocument('View_'+name)
   for label,shape,color,trans in items:
    q=d.addObject('PartDesign::Feature',label);q.Shape=shape.copy();q.ViewObject.ShapeColor=color;q.ViewObject.Transparency=trans
   d.recompute();G.updateGui();QtWidgets.QApplication.processEvents();v=G.activeDocument().activeView()
   if view=='top':v.viewTop()
   elif view=='rear':v.viewRear()
   else:v.viewAxonometric()
   G.updateGui();v.fitAll();G.updateGui();QtWidgets.QApplication.processEvents();v.fitAll();path=os.path.join(R,'IMAGES',name+'.png');v.saveImage(path,1200,900,'White');im=QtGui.QImage(path);n=sum(min(im.pixelColor(x,y).red(),im.pixelColor(x,y).green(),im.pixelColor(x,y).blue())<230 for y in range(0,900,12) for x in range(0,1200,12));assert n>20;qa[name]={'real_CAD':True,'nonwhite_samples':n};A.closeDocument(d.Name)
  for i,o in enumerate(objects):scene(o.Label[:2],[(o.Name,o.Shape,colors[i],0)])
  scene('layout',[(o.Name,o.Shape,colors[i],0) for i,o in enumerate(objects)],'top')
  female=next(o for o in objects if o.Label.startswith('06'));sleeve=next(o for o in objects if o.Label.startswith('07'));s=sleeve.Shape.copy();b=s.BoundBox;s.translate(V(89.7-(b.XMin+b.XMax)/2,50-(b.YMin+b.YMax)/2,-1.1-b.ZMin));cut=female.Shape.common(Part.makeBox(19,20,10,V(80,40,-3)))
  assert cut.common(s).Volume<1e-6;scene('tilt_bore_detail',[('FemaleTab',cut,(.18,.4,.72),45),('ActualSleeve',s,(.6,.3,.72),0)])
  full=A.openDocument(os.path.join(R,'..','..','CAD','EyeTrace_Final_Assembly.FCStd'));items=[]
  for o in full.Objects:
   if not hasattr(o,'KinematicGroup'):continue
   if o.Name=='CameraPlate_Cut007' or o.Name=='PCB_Cut003' or o.Name.startswith(('Camera_M2','PCB_Spacer','Camera_Rear')):
    c=(.7,.7,.72);t=0
    if o.Name=='PCB_Cut003':c=(.12,.5,.25);t=70
    elif o.Name=='CameraPlate_Cut007':c=(.9,.55,.15);t=30
    elif o.Name.startswith('PCB_Spacer'):c=(.15,.55,.8)
    elif o.Name.startswith('Camera_Rear'):c=(.9,.15,.1);t=85
    items.append((o.Name,o.Shape,c,t))
  scene('camera_rear_uncertainty',items)
  json.dump({'renderer':'FreeCAD1.1.4 actual saved BRep geometry','images':qa,'physical_results':'NOT PERFORMED','camera_red_box':'Unmeasured uncertainty, not actual camera material'},open(os.path.join(R,'CHECKS','render_QA.json'),'x'),indent=2)
 except Exception:open(os.path.join(R,'CHECKS','render_error.txt'),'x').write(traceback.format_exc())
 finally:
  for n in list(A.listDocuments()):A.closeDocument(n)
  QtCore.QTimer.singleShot(500,QtWidgets.QApplication.instance().quit)
QtCore.QTimer.singleShot(1000,run)
