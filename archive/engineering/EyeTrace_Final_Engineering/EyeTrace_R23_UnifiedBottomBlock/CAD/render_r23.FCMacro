import FreeCAD as App, FreeCADGui as Gui
p=r'EyeTrace_Final_Engineering\EyeTrace_R23_UnifiedBottomBlock\CAD\EyeTrace_R23_UnifiedBottomBlock.FCStd'
out=r'EyeTrace_Final_Engineering\EyeTrace_R23_UnifiedBottomBlock\SCREENSHOTS\R23_UnifiedBottomBlock_Isometric.png'
d=App.openDocument(p)
for o in d.Objects:
 if hasattr(o,'ViewObject'): o.ViewObject.Visibility=False
names=['Base_EarMount_ThrustSupport','PanYoke_EarBracket_KeyedDrive','Pan_KeyedHorn_Cover','PanServo_SG90_Reference','Pan_OriginalStar_PROVISIONAL','PanOriginalScrew_PROVISIONAL','PanDrive_M3x10_0','PanDrive_M3x10_1','PanDrive_M3x10_2','PanDrive_M3x10_3']
for n in names:
 o=d.getObject(n)
 if o and hasattr(o,'ViewObject'):
  o.ViewObject.Visibility=True
  if n=='Base_EarMount_ThrustSupport':o.ViewObject.ShapeColor=(0.70,0.72,0.75)
  elif n=='PanYoke_EarBracket_KeyedDrive':o.ViewObject.ShapeColor=(0.38,0.67,0.84)
  elif n=='Pan_KeyedHorn_Cover':o.ViewObject.ShapeColor=(0.91,0.45,0.17)
  elif n=='Pan_OriginalStar_PROVISIONAL':o.ViewObject.ShapeColor=(0.95,0.95,0.97)
  else:o.ViewObject.ShapeColor=(0.28,0.31,0.36)
  o.ViewObject.DisplayMode='Flat Lines'
Gui.activeDocument().activeView().viewAxonometric()
Gui.activeDocument().activeView().fitAll()
Gui.activeDocument().activeView().saveImage(out,1600,1100,'Current')
