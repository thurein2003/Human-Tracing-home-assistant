p=r'EyeTrace_Final_Engineering\EyeTrace_R23_UnifiedBottomBlock\CAD\EyeTrace_R23_UnifiedBottomBlock.FCStd';d=App.openDocument(p);y=d.getObject('PanYoke_EarBracket_KeyedDrive');pg=d.getObject('PrintedParts');root=d.getObject('AssemblyRoot')
