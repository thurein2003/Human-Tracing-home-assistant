import FreeCAD as App,Part,json
p=r'EyeTrace_Final_Engineering\EyeTrace_R23_UnifiedBottomBlock\CAD\EyeTrace_R23_UnifiedBottomBlock.FCStd';d=App.openDocument(p); y=d.getObject('PanYoke_EarBracket_KeyedDrive').Shape; base=d.getObject('Base_EarMount_ThrustSupport').Shape
pts=[(30,0),(30,20),(31,20),(32,20),(33,20),(30,23),(32.5,23.5),(34,0),(40,0),(40,-20),(30,-20),(30,-25)]
out=[]
for x,yy in pts:
 q=y.common(Part.makeBox(.2,.2,120,App.Vector(x-.1,yy-.1,0)))
 out.append({'xy':[x,yy],'yoke_z':[q.BoundBox.ZMin,q.BoundBox.ZMax,q.BoundBox.ZLength] if q.Volume>1e-8 else None})
basecommon=y.common(base).Volume
open(r'EyeTrace_Final_Engineering\EyeTrace_R23_UnifiedBottomBlock\DOCUMENTATION\yoke_overlap_measurements.json','w').write(json.dumps({'points':out,'yoke_bbox':[y.BoundBox.XMin,y.BoundBox.XMax,y.BoundBox.YMin,y.BoundBox.YMax,y.BoundBox.ZMin,y.BoundBox.ZMax],'base_intersection_mm3':basecommon,'yoke_base_distance_mm':y.distToShape(base)[0]},indent=2))
