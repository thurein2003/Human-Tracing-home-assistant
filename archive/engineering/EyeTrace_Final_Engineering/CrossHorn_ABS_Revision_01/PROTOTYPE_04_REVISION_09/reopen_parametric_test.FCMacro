import json
from pathlib import Path
import FreeCAD as App, Part
from FreeCAD import Vector as V
p=Path(r"EyeTrace_Final_Engineering\CrossHorn_ABS_Revision_01\PROTOTYPE_04_REVISION_09")
d=App.openDocument(str(p/'CrossHorn_UltraMinimal_FitTest_04R09.FCStd'))
params=d.getObject('Parameters'); final=d.getObject('FinalCoupon'); ft=d.getObject('FrontRecessTool'); bt=d.getObject('BackRecessTool')
d.recompute(); v0=final.Shape.Volume
# Actual vertical section of reopened saved BRep at Y=0
plane=Part.Face(Part.Wire(Part.makePolygon([V(-50,0,-10),V(50,0,-10),V(50,0,10),V(-50,0,10),V(-50,0,-10)])))
sec=final.Shape.section(plane)
seg=[]
for e in sec.Edges:
 pts=e.discretize(Deflection=0.001)
 if len(pts)>1 and all(abs(abs(x.x)-3.7)<1e-5 for x in pts):
  z=[x.z for x in pts]
  if abs(max(z)-min(z)-3.2)<1e-5: seg.append([min(z),max(z)])
assert seg,seg
params.FrontDepth=3.1; d.recompute(); vf=final.Shape.Volume; fh=ft.Shape.BoundBox.ZLength
params.FrontDepth=3.2; d.recompute(); vrestore=final.Shape.Volume
params.BackDepth=0.5; d.recompute(); vb=final.Shape.Volume; bh=bt.Shape.BoundBox.ZLength
params.BackDepth=0.3; d.recompute(); vlast=final.Shape.Volume
web=params.CalculatedCenterWeb.Value
res={'reopened':True,'brep_section_vertical_wall_z_mm':seg,'brep_measured_depth_mm':max(seg[0])-min(seg[0]),'seat_z_mm':2.1,'floor_z_mm':-1.1,'baseline_volume_mm3':v0,'front_depth_edit_mm':3.1,'front_cutter_height_mm':fh,'front_volume_delta_mm3':vf-v0,'back_depth_edit_mm':0.5,'back_cutter_height_mm':bh,'back_volume_delta_mm3':vb-vrestore,'restored_front_depth_mm':params.FrontDepth.Value,'restored_back_depth_mm':params.BackDepth.Value,'web_mm':web,'restored_volume_mm3':vlast,'valid':final.Shape.isValid(),'solids':len(final.Shape.Solids)}
assert abs(res['brep_measured_depth_mm']-3.2)<1e-6 and abs(fh-3.1)<1e-8 and abs(bh-.5)<1e-8
assert abs(res['front_volume_delta_mm3'])>.1 and abs(res['back_volume_delta_mm3'])>.1
assert abs(params.FrontDepth.Value-3.2)<1e-8 and abs(params.BackDepth.Value-.3)<1e-8 and abs(web-.8)<1e-8
assert res['valid'] and res['solids']==1
(p/'reopen_parametric_validation.json').write_text(json.dumps(res,indent=2),encoding='utf-8')
print('REOPEN_VALIDATION='+json.dumps(res))
App.closeDocument(d.Name)
