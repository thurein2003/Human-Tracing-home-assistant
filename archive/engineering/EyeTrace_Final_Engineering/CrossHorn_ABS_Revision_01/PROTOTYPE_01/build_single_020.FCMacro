from pathlib import Path
import FreeCAD as App, Part, MeshPart
from FreeCAD import Vector as V
out=Path(r"EyeTrace_Final_Engineering\CrossHorn_ABS_Revision_01\PROTOTYPE_01")
c=0.20 # total lateral clearance; radial expansion on each side is c/2
zheight=1.7
def bar(L,w,h,axis='x'):
    r=w/2; core=L-2*r
    s=Part.makeBox(core,w,h,V(-core/2,-r,0))
    for x in (-core/2,core/2): s=s.fuse(Part.makeCylinder(r,h,V(x,0,0)))
    if axis=='y': s.rotate(V(0,0,0),V(0,0,1),90)
    return s.removeSplitter()
cross=bar(35+c,3.2+c,zheight).fuse(bar(18+c,3.0+c,zheight,'y')).removeSplitter()
plate=Part.makeBox(43,27,4,V(-21.5,-13.5,0))
pocket=cross.copy(); pocket.translate(V(0,0,4-zheight)); plate=plate.cut(pocket)
# Hub recess: 7 mm measured nominal plus half-clearance per side; 2.5 mm published provisional hub height + 0.2 axial allowance.
plate=plate.cut(Part.makeCylinder(3.6,2.7,V(0,0,1.3)))
# Through access: 4.5 mm provisional aperture, kept open for the original horn screw/driver.
plate=plate.cut(Part.makeCylinder(2.25,5,V(0,0,-0.5)))
# Two raised dots identify the 0.20 mm variant.
for x in (-17.0,-15.0): plate=plate.fuse(Part.makeCylinder(0.65,0.35,V(x,-9.5,4)))
plate=plate.removeSplitter()
if not plate.isValid() or len(plate.Solids)!=1: raise RuntimeError('Coupon invalid or not a single solid')
doc=App.newDocument('CrossHorn_Single_FitTest_020')
obj=doc.addObject('PartDesign::Feature','CrossHornCoupon020'); obj.Label='Single cross-horn fit-test coupon - 0.20 mm total lateral clearance'; obj.Shape=plate
for n,v in [('TotalLateralClearance',0.20),('LongSpan',35.0),('ShortSpan',18.0),('HubDiameter',7.0),('CameraHolePitchX',21.0),('CameraHolePitchY',14.0)]:
    obj.addProperty('App::PropertyLength',n,'Parameters'); setattr(obj,n,v)
obj.addProperty('App::PropertyString','Assumptions','Engineering'); obj.Assumptions='Arm widths 3.2/3.0, centered hub, 1.5 mm horn plate, 2.5 mm boss height and 4.5 mm center access are provisional.'
doc.recompute(); doc.saveAs(str(out/'CrossHorn_Single_FitTest_020.FCStd'))
mesh=MeshPart.meshFromShape(Shape=plate,LinearDeflection=0.05,AngularDeflection=0.10,Relative=False)
mesh.write(str(out/'CrossHorn_Single_FitTest_020.stl'))
print('solid_valid',plate.isValid(),'solids',len(plate.Solids),'mesh_facets',len(mesh.Facets),'mesh_solid',mesh.isSolid(),'bbox',plate.BoundBox.XLength,plate.BoundBox.YLength,plate.BoundBox.ZLength)
