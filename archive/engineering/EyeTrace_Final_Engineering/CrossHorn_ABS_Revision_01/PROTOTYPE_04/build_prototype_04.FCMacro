import json, math
from pathlib import Path
import FreeCAD as App, Part, MeshPart
from FreeCAD import Vector as V
OUT=Path(r'EyeTrace_Final_Engineering\CrossHorn_ABS_Revision_01\PROTOTYPE_04')
# Horn #3 PDF dimensions are provisional reference data. Confirmed user dimensions override its total spans/hub.
P={
 'units':'mm',
 'confirmed_user_dimensions':{'long_span':35.0,'short_span_baseline':18.0,'hub_diameter':7.0},
 'published_horn3_reference':{'source':'https://www.auselectronicsdirect.com.au/assets/brochures/TA0132.pdf, page 5','drawing_span':34.5,'hub_to_long_end_a':16.0,'hub_to_long_end_b':18.5,'short_span_drawing':16.3,'raised_hub_diameter_drawing':6.9,'raised_hub_height_drawing':2.5,'main_plate_thickness_drawing':1.5,'long_arm_side_angle_a_deg':6.3,'long_arm_side_angle_b_deg':8.0,'confidence':'Published dimensions/profile for a similar Horn #3; actual clone compatibility unverified'},
 'pocket_parameters_provisional_mm':{'total_lateral_clearance':0.20,'long_root_width_reference_estimate':7.0,'short_arm_width_reference_estimate':3.2,'short_extension_each_end_from_prototype_01':1.0,'hub_recess_diameter':7.4,'hub_recess_depth':2.7,'screw_access_diameter':4.5,'arm_recess_depth':1.7,'outer_margin':1.4,'base_thickness':3.7},
 'design_interpretations':{'hub_offset_from_geometric_span_center_x':-1.25,'long_taper_angles_treated_as_total_width_convergence_angles':True,'unmeasured_arm_widths_are_raster/profile_estimates_only':True,'screw_access_not_horn_spline_geometry':True},
 'printing':{'material':'ABS','layer_height_mm':0.20,'walls':2,'infill_percent':0,'supports':False,'brim_mm':4,'orientation':'flat base on bed, pocket upward','nozzle_C':255,'bed_C':100}
}
# Preserve actual measured overall span, while using Horn #3 end-length asymmetry and taper-angle guidance.
clear=P['pocket_parameters_provisional_mm']['total_lateral_clearance']; m=P['pocket_parameters_provisional_mm']['outer_margin']
ref=P['published_horn3_reference']; q=P['pocket_parameters_provisional_mm']; b=q['base_thickness']
nominal_span=P['confirmed_user_dimensions']['long_span']; huboff=P['design_interpretations']['hub_offset_from_geometric_span_center_x']
left_nom=nominal_span/2.0+huboff # 16.25 when hub lies 1.25mm left of span midpoint
right_nom=nominal_span/2.0-huboff # 18.75
left_L=left_nom+clear/2.0; right_L=right_nom+clear/2.0
root_nom=q['long_root_width_reference_estimate']
left_tip_nom=root_nom-left_nom*math.tan(math.radians(ref['long_arm_side_angle_a_deg']))
right_tip_nom=root_nom-right_nom*math.tan(math.radians(ref['long_arm_side_angle_b_deg']))
short_nom=P['confirmed_user_dimensions']['short_span_baseline']+2*q['short_extension_each_end_from_prototype_01']
short_pocket_span=short_nom+clear
short_half=short_pocket_span/2.0
root_pocket=root_nom+clear
left_tip=left_tip_nom+clear; right_tip=right_tip_nom+clear
short_width_nom=q['short_arm_width_reference_estimate']; short_width=short_width_nom+clear
if min(left_tip_nom,right_tip_nom,short_width_nom)<=0: raise ValueError('non-positive provisional profile dimension')

def make_arm(length, rootw, tipw, z, height, sign=1, axis='x'):
    rad=tipw/2.0; c=length-rad
    poly=[V(0,-rootw/2,z),V(sign*c,-tipw/2,z),V(sign*c,tipw/2,z),V(0,rootw/2,z),V(0,-rootw/2,z)]
    web=Part.Face(Part.Wire(Part.makePolygon(poly))).extrude(V(0,0,height))
    cap=Part.makeCylinder(rad,height,V(sign*c,0,z))
    s=web.fuse(cap).removeSplitter()
    if axis=='y': s.rotate(V(0,0,z),V(0,0,1),90)
    return s

def cross_profile(xleft,xright,yhalf,rootw,lefttip,righttip,shortw,z,h):
    bits=[make_arm(xleft,rootw,lefttip,z,h,-1,'x'),make_arm(xright,rootw,righttip,z,h,1,'x'),make_arm(yhalf,shortw,shortw,z,h,-1,'y'),make_arm(yhalf,shortw,shortw,z,h,1,'y')]
    return bits[0].fuse(bits[1]).fuse(bits[2]).fuse(bits[3]).removeSplitter()
# Outer cross follows recess envelope with 2.7 mm nominal edge margin; dimension expansion applied per side.
outer=cross_profile(left_L+m,right_L+m,short_half+m,root_pocket+2*m,left_tip+2*m,right_tip+2*m,short_width+2*m,0,b)
# One compact solid, no backing plate. Pocket is blind; center screw/driver access is a distinct through bore.
shape=outer
z_arm=b-q['arm_recess_depth']
pockets=[make_arm(left_L,root_pocket,left_tip,z_arm,q['arm_recess_depth'],-1,'x'),make_arm(right_L,root_pocket,right_tip,z_arm,q['arm_recess_depth'],1,'x'),make_arm(short_half,short_width,short_width,z_arm,q['arm_recess_depth'],-1,'y'),make_arm(short_half,short_width,short_width,z_arm,q['arm_recess_depth'],1,'y')]
cut=pockets[0].fuse(pockets[1]).fuse(pockets[2]).fuse(pockets[3]).removeSplitter()
shape=shape.cut(cut)
shape=shape.cut(Part.makeCylinder(q['hub_recess_diameter']/2,q['hub_recess_depth'],V(0,0,b-q['hub_recess_depth'])))
shape=shape.cut(Part.makeCylinder(q['screw_access_diameter']/2,b+1,V(0,0,-0.5))).removeSplitter()
if not shape.isValid() or len(shape.Solids)!=1: raise RuntimeError('Coupon is not exactly one valid connected solid')
floor_hub=b-q['hub_recess_depth']; floor_arms=b-q['arm_recess_depth']
if floor_hub < 0.8-1e-6 or floor_arms < 0.8-1e-6: raise RuntimeError('Insufficient floor under blind pockets')
# Save editable native geometry with provenance properties.
doc=App.newDocument('CrossHorn_UltraMinimal_FitTest_04')
obj=doc.addObject('PartDesign::Feature','Horn3CrossFitCoupon'); obj.Label='Thin-walled Horn #3 profile cross-horn fit gauge - provisional'; obj.Shape=shape
props={'LongSpanConfirmed':35.0,'ShortSpanBaselineConfirmed':18.0,'ShortPocketSpan':short_pocket_span,'HubDiameterConfirmed':7.0,'HubRecessDiameter':q['hub_recess_diameter'],'HubRecessDepth':q['hub_recess_depth'],'ScrewAccessDiameter':q['screw_access_diameter'],'TotalLateralClearance':clear,'HubOffsetXProvisional':huboff,'LeftRootWidthPocket':root_pocket,'LeftTipWidthPocket':left_tip,'RightTipWidthPocket':right_tip,'ShortArmWidthPocket':short_width,'ShortExtensionPerEnd':1.0,'OuterMargin':m,'BaseThickness':b,'ArmRecessDepth':q['arm_recess_depth'],'HubFloor':floor_hub,'ArmFloor':floor_arms,'LeftEndTaperAngleRef':ref['long_arm_side_angle_a_deg'],'RightEndTaperAngleRef':ref['long_arm_side_angle_b_deg']}
for n,v in props.items(): obj.addProperty('App::PropertyLength' if n not in ('LeftEndTaperAngleRef','RightEndTaperAngleRef') else 'App::PropertyAngle',n,'Parameters'); setattr(obj,n,v)
obj.addProperty('App::PropertyString','PhysicalFitStatus','Verification'); obj.PhysicalFitStatus='UNVERIFIED - provisional drawing-derived profile; test with actual horn'
obj.addProperty('App::PropertyString','RebuildInstructions','Verification'); obj.RebuildInstructions='Source parameter data is parameters.json. Re-run build_prototype_03_revision_02.FCMacro to regenerate.'
doc.recompute(); doc.saveAs(str(OUT/'CrossHorn_UltraMinimal_FitTest_04.FCStd'))
mesh=MeshPart.meshFromShape(Shape=shape,LinearDeflection=0.025,AngularDeflection=0.06,Relative=False)
mesh.write(str(OUT/'CrossHorn_UltraMinimal_FitTest_04.stl'))
bbox=shape.BoundBox
res={'solid_valid':shape.isValid(),'solid_count':len(shape.Solids),'mesh_facets':len(mesh.Facets),'mesh_is_solid':mesh.isSolid(),'bbox_mm':[bbox.XLength,bbox.YLength,bbox.ZLength],'solid_volume_mm3':shape.Volume,'long_nominal_span_mm':35.0,'long_pocket_span_mm':left_L+right_L,'left_pocket_reach_from_hub_mm':left_L,'right_pocket_reach_from_hub_mm':right_L,'hub_offset_from_span_midpoint_mm':huboff,'short_baseline_mm':18.0,'short_end_extension_each_end_mm':1.0,'short_pocket_span_including_extension_and_clearance_mm':short_pocket_span,'long_root_width_pocket_mm':root_pocket,'left_tip_width_pocket_mm':left_tip,'right_tip_width_pocket_mm':right_tip,'short_arm_width_pocket_mm':short_width,'hub_recess_diameter_mm':q['hub_recess_diameter'],'hub_recess_depth_mm':q['hub_recess_depth'],'screw_access_diameter_mm':q['screw_access_diameter'],'hub_floor_mm':floor_hub,'arm_floor_mm':floor_arms,'outer_margin_mm':m,'parameters':P,'freecad_properties':props}
(OUT/'geometry_validation.json').write_text(json.dumps(res,indent=2),encoding='utf-8'); (OUT/'parameters.json').write_text(json.dumps(P,indent=2),encoding='utf-8')
# Actual screenshots from the FreeCAD viewport.
for o in doc.Objects:
    if hasattr(o,'ViewObject'): o.ViewObject.ShapeColor=(0.78,0.82,0.88); o.ViewObject.LineColor=(0.12,0.15,0.20)
Gui.activeDocument().activeView().viewTop(); Gui.activeDocument().activeView().fitAll(); Gui.activeDocument().activeView().saveImage(str(OUT/'CrossHorn_UltraMinimal_FitTest_04_Top.png'),1600,1100,'Current')
Gui.activeDocument().activeView().viewAxonometric(); Gui.activeDocument().activeView().fitAll(); Gui.activeDocument().activeView().saveImage(str(OUT/'CrossHorn_UltraMinimal_FitTest_04_Isometric.png'),1600,1100,'Current')
print(json.dumps(res,indent=2))
App.closeDocument(doc.Name)
try: Gui.getMainWindow().close()
except: pass


