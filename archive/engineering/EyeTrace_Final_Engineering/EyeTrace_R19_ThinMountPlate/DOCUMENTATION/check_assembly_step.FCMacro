import FreeCAD as A,Part,json,os
root=r'EyeTrace_Final_Engineering\EyeTrace_R19_ThinMountPlate'; d=A.newDocument('R19AssemblyStepCheck'); Part.insert(root+r'\CAD\EyeTrace_R19_Assembly.step',d.Name); d.recompute(); objs=[o for o in d.Objects if hasattr(o,'Shape') and not o.Shape.isNull()]; res=[]
for o in objs: res.append({'name':o.Name,'valid':o.Shape.isValid(),'solids':len(o.Shape.Solids),'volume':o.Shape.Volume})
t={'objects':res,'total_solids':sum(x['solids'] for x in res),'valid':all(x['valid'] for x in res)}
open(root+r'\DOCUMENTATION\r19_assembly_step_check.json','w').write(json.dumps(t,indent=2));print(json.dumps(t,indent=2))
