import FreeCAD as A, Part, json, math
from FreeCAD import Vector as V
src=r'EyeTrace_Final_Engineering\EyeTrace_Final_2_PLATES_R15\CAD\EyeTrace_R15_Final_Assembly.FCStd'
out=r'EyeTrace_Final_Engineering\EyeTrace_Final_2_PLATES_R16_COMPACT_SERVO\CHECKS\reference_geometry_audit.json'
d=A.openDocument(src)
def bb(s):
 b=s.BoundBox; return [b.XMin,b.YMin,b.ZMin,b.XMax,b.YMax,b.ZMax]
def ser(s):
 cylinders=[]
 for i,f in enumerate(s.Faces):
  surf=f.Surface
  if 'Cylinder' in str(type(surf)):
   c=surf.Center; cylinders.append({'face':i+1,'radius_mm':surf.Radius,'center_mm':[c.x,c.y,c.z],'axis':[surf.Axis.x,surf.Axis.y,surf.Axis.z],'area_mm2':f.Area})
 return cylinders
names=['PanServo_SG90_Reference','TiltServo_SG90_Reference','Pan_OriginalStar_PROVISIONAL','Tilt_OriginalStar_PROVISIONAL','PanYoke_EarBracket_KeyedDrive','TiltCradle_KeyedHorn_CameraFrame','Pan_KeyedHorn_Cover','Tilt_KeyedHorn_CaptiveCover','Base_EarMount_ThrustSupport']
rows=[]
for n in names:
 o=d.getObject(n); s=o.Shape
 rows.append({'name':n,'label':o.Label,'bbox_mm':bb(s),'volume_mm3':s.Volume,'valid':s.isValid(),'solids':len(s.Solids),'placement_base':[o.Placement.Base.x,o.Placement.Base.y,o.Placement.Base.z],'placement_axis':[o.Placement.Rotation.Axis.x,o.Placement.Rotation.Axis.y,o.Placement.Rotation.Axis.z],'placement_angle_rad':o.Placement.Rotation.Angle,'cylinders':ser(s)})
with open(out,'w') as f: json.dump({'freecad_version':A.Version()[:4],'source':src,'objects':rows},f,indent=2)
print(json.dumps({'version':A.Version()[:4],'objects':[{k:r[k] for k in ['name','bbox_mm','volume_mm3','cylinders']} for r in rows]},indent=2))
