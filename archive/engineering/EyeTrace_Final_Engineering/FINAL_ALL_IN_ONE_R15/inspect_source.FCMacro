import FreeCAD as A, json, os
root=r'EyeTrace_Final_Engineering'
out=root+r'\FINAL_ALL_IN_ONE_R15\source_component_audit.json'
d=A.openDocument(root+r'\Camera_21x14_Correction_01\CAD\EyeTrace_Final_Assembly_21x14.FCStd')
rows=[]
for o in d.Objects:
 if hasattr(o,'KinematicGroup') and hasattr(o,'Shape') and not o.Shape.isNull():
  b=o.Shape.BoundBox
  row={'name':o.Name,'label':o.Label,'printable':bool(getattr(o,'Printable',False)),'print_file':str(getattr(o,'PrintFileName','')),'kinematic_group':str(o.KinematicGroup),'bbox_local':[b.XMin,b.YMin,b.ZMin,b.XMax,b.YMax,b.ZMax],'volume':o.Shape.Volume,'solids':len(o.Shape.Solids),'valid':o.Shape.isValid(),'placement':{'base':[o.Placement.Base.x,o.Placement.Base.y,o.Placement.Base.z],'rotation_axis':[o.Placement.Rotation.Axis.x,o.Placement.Rotation.Axis.y,o.Placement.Rotation.Axis.z],'angle_deg':o.Placement.Rotation.Angle*180/3.141592653589793}}
  rows.append(row)
open(out,'w').write(json.dumps(rows,indent=2))
A.closeDocument(d.Name)
