import FreeCAD as A, FreeCADGui as G, Part, os, time
from FreeCAD import Vector as V
p=r'EyeTrace_Final_Engineering\EyeTrace_Final_2_PLATES_R17_HORN_CLEANUP'
d=A.openDocument(p+r'\CAD\EyeTrace_R17_HornCleanup_Assembly.FCStd')
for o in d.Objects:
 try:o.Visibility=False
 except:pass
view=G.activeDocument().activeView()
def render(name,objname,orientation,section=None):
 for o in d.Objects:
  try:o.Visibility=False
  except:pass
 src=d.getObject(objname)
 if section is None:
  src.Visibility=True
  target=src
 else:
  target=d.addObject('Part::Feature','Section_'+name)
  target.Shape=section(src.Shape)
  target.Label=name+' section cut'
  target.ViewObject.ShapeColor=(0.85,0.62,0.28)
  target.ViewObject.LineColor=(0.15,0.15,0.15)
  target.Visibility=True
  target.ViewObject.DisplayMode='Flat Lines'
 if orientation=='bottom': view.viewBottom()
 elif orientation=='front': view.viewFront()
 elif orientation=='left': view.viewLeft()
 elif orientation=='right': view.viewRight()
 elif orientation=='top': view.viewTop()
 else:view.viewAxonometric()
 view.fitAll(); G.updateGui(); time.sleep(0.7)
 view.saveImage(p+r'\RENDERS\'+name+'.png','Current',1600,1200)
 if section is not None:d.removeObject(target.Name)
render('After_Pan_Interface_Bottom','PanYoke_EarBracket_KeyedDrive','bottom')
render('After_Tilt_Interface_Face','TiltCradle_KeyedHorn_CameraFrame','left')
def panCut(sh): return sh.common(Part.makeBox(120,60,20,V(-60,0,28)))
def tiltCut(sh): return sh.common(Part.makeBox(20,60,60,V(-46,0,48)))
render('After_Pan_Interface_Section','PanYoke_EarBracket_KeyedDrive','front',panCut)
render('After_Tilt_Interface_Section','TiltCradle_KeyedHorn_CameraFrame','left',tiltCut)
print('RENDERS_WRITTEN')

