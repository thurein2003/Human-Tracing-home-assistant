import zipfile,json,os
from xml.etree import ElementTree as ET
root=r'EyeTrace_Final_Engineering\R15_BASE_ABS_OPTIMIZED'
for srcname,dstname,walls,inf in [('V0_Baseline_4W_35pct_ABS.3mf','V5_NormalAutoSupport_4W35_ABS.3mf',4,35),('V3_3W_20pct_Gyroid_ABS.3mf','V6_NormalAutoSupport_3W20_ABS.3mf',3,20)]:
 with zipfile.ZipFile(os.path.join(root,srcname)) as z: data={n:z.read(n) for n in z.namelist()}
 for cfg in ('Metadata/project_settings.config','Metadata/process_settings_1.config'):
  d=json.loads(data[cfg]);d['wall_loops']=str(walls);d['sparse_infill_density']=str(inf)+'%';d['sparse_infill_pattern']='gyroid';d['support_type']='normal(auto)';d['support_on_build_plate_only']='0';d['support_top_z_distance']='0.24';d['support_bottom_z_distance']='0.24';d['curr_bed_type']='Textured PEI Plate';d['textured_plate_temp']='100';d['textured_plate_temp_initial_layer']='100';data[cfg]=json.dumps(d,indent=2).encode()
 ms=ET.fromstring(data['Metadata/model_settings.config'])
 for o in ms.findall('object'):
  for m in o.findall('metadata'):
   if m.get('key')=='support_type':m.set('value','normal(auto)')
   if m.get('key')=='support_style':m.set('value','default')
   if m.get('key')=='enable_support':m.set('value','1')
 data['Metadata/model_settings.config']=ET.tostring(ms,encoding='utf-8',xml_declaration=True)
 dst=os.path.join(root,dstname)
 with zipfile.ZipFile(dst,'w',zipfile.ZIP_DEFLATED) as z:
  for n,b in data.items():z.writestr(n,b)
 with zipfile.ZipFile(dst) as z: assert z.testzip() is None
